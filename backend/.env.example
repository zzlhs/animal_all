NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

DATABASE_URL=postgres://gbif:gbif@localhost:5432/gbif_globe
DATABASE_SSL=false
DATABASE_POOL_MAX=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUDIO_PROXY_ALLOWED_HOSTS=observation.org,www.observation.org,xeno-canto.org,www.xeno-canto.org

ACTIVE_DATASET_VERSION=dwca-2026-08-27
PMTILES_URL=
PMTILES_SOURCE_LAYER=gbif_occurrences
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/gbif-photo-globe
IMAGEKIT_SYNC_MEDIA_TYPES=image,video
IMAGEKIT_SYNC_CONCURRENCY=3
IMAGEKIT_SYNC_MAX_ATTEMPTS=5
IMAGEKIT_SYNC_RETRY_DELAY_SECONDS=60

# S3 / Cloudflare R2 compatible storage for PMTiles. Keep secrets server-side.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_VERIFY_ORIGIN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

IMPORT_KINGDOM=Animalia
IMPORT_BATCH_SIZE=500
H3_BASE_RESOLUTION=8
