# Local development template. Copy to .env.local at the repository root.
# Startup and data npm commands automatically load .env then .env.local.
# Existing shell environment variables take precedence.
# Values below are for a NEW local development database only.
POSTGRES_DB=gbif
POSTGRES_USER=gbif
POSTGRES_PASSWORD=gbif
POSTGRES_PORT=5432
DATABASE_URL='postgres://gbif:gbif@127.0.0.1:5432/gbif'
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=8000

# Worker default dataset name. This does NOT change the web active release.
ACTIVE_DATASET_VERSION=gbif-100k-20260928
IMPORT_KINGDOM=Animalia
IMPORT_BATCH_SIZE=500
H3_BASE_RESOLUTION=8
PMTILES_SOURCE_LAYER=gbif_occurrences
PUBLIC_APP_URL=http://127.0.0.1:3000
# Audio tasks download into memory and upload to ImageKit.
IMAGEKIT_PUBLIC_KEY=''
IMAGEKIT_PRIVATE_KEY=''
# SDK upload API and account delivery endpoint are different addresses.
IMAGEKIT_UPLOAD_ENDPOINT=https://upload.imagekit.io/api/v1/files/upload
IMAGEKIT_URL_ENDPOINT=''
IMAGEKIT_FOLDER=/gbif-photo-globe
# IMAGEKIT_AUDIO_FOLDER=/gbif-photo-globe/audios
# The embedded worker starts with the web app. For a separate worker, set false
# and run npm run audio:worker (or the compose audio-worker profile).
AUDIO_WORKER_EMBEDDED=true
AUDIO_FIRST_RESPONSE_TIMEOUT_MS=20000
AUDIO_IDLE_TIMEOUT_MS=30000
AUDIO_TOTAL_TIMEOUT_MS=600000
# Set within the upload and delivery limits of your ImageKit account.
AUDIO_MAX_BYTES=20971520
# Optional absolute directory for locally hosted PMTiles. Default: data/maps.
# MAP_STORAGE_DIR=/absolute/path/to/data/maps
# Persistent thumbnails and basemap cache. Default: data/cache (512 MiB images + 1 GiB basemap).
# RESOURCE_CACHE_DIR=/absolute/path/to/data/cache
# Optional CDN/asset origin serving the same /api/basemap paths; requires a rebuild.
# VITE_BASEMAP_ASSET_ORIGIN=https://assets.example.com

# Optional S3-compatible storage: required only for map:upload.
OBJECT_STORAGE_ENDPOINT=''
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=''
OBJECT_STORAGE_ACCESS_KEY_ID=''
OBJECT_STORAGE_SECRET_ACCESS_KEY=''
OBJECT_STORAGE_PUBLIC_BASE_URL=''
OBJECT_STORAGE_VERIFY_ORIGIN='http://localhost:3000'
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Production Node listener. Vite dev uses port 3000 in apps/web/vite.config.ts.
HOST=127.0.0.1
PORT=3000
