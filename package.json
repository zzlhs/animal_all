{
  "name": "gbif-photo-globe-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:frontend": "node scripts/run-frontend.mjs install",
    "install:backend": "node scripts/run-backend.mjs install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "dev": "node scripts/run-frontend.mjs dev",
    "build": "node scripts/run-frontend.mjs build",
    "build:api": "node scripts/run-backend.mjs build",
    "build:all": "npm run build && npm run build:api",
    "test": "node scripts/run-frontend.mjs test",
    "test:api": "node scripts/run-backend.mjs test",
    "test:all": "npm test && npm run test:api",
    "preview": "node scripts/run-frontend.mjs preview",
    "start": "node scripts/run-frontend.mjs start",
    "dev:api": "node scripts/run-backend.mjs dev"
  }
}
